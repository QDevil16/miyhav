# Miyhav — Örnek ortam değişkenleri
# Bu dosya SADECE anahtar isimlerini gösterir. GERÇEK secret İÇERMEZ.
# Gerçek değerler koda yazılmaz; --dart-define veya CI secret ile verilir.

# --- Mobil uygulamada bulunabilir (public) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Ortam ---
APP_ENV=development   # development | production

# ============================================================
# AŞAĞIDAKİLER MOBİL UYGULAMAYA KESİNLİKLE KONMAZ.
# Yalnızca sunucu (Edge Function / Supabase secret) veya CI tarafında tutulur.
# Buraya gerçek değer yazma; bunlar yalnızca hatırlatma amaçlıdır.
# ------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=            (server-only)
# FCM_SERVICE_ACCOUNT_JSON=             (Edge Function secret)
# RESEND_API_KEY=                       (ileride, server-only)
# APPLE_APP_STORE_CONNECT_KEY_P8=       (Codemagic secret)
# APPLE_ISSUER_ID=                      (Codemagic secret)
# APPLE_KEY_ID=                         (Codemagic secret)
# ANDROID_KEYSTORE_PASSWORD=            (CI secret)
# ============================================================
